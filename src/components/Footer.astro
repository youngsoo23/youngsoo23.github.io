---
import { contact } from '../data/about';
---

<footer class="mx-auto mt-20 max-w-3xl border-t border-line px-6 py-8 text-xs text-ink-faint">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span>오영수 — Backend Developer</span>
    <div class="flex flex-wrap gap-4">
      <a href={`mailto:${contact.email}`} class="hover:text-ink">{contact.email}</a>
      <a href={contact.github} target="_blank" rel="noopener" class="hover:text-ink">GitHub</a>
      <a href="#top" class="hover:text-ink">맨 위로</a>
    </div>
  </div>
</footer>
