---
const links = [
  { href: '/', label: '홈' },
  { href: '/about', label: '소개' },
  { href: '/career', label: '경력' },
  { href: '/projects', label: '프로젝트' },
  { href: '/posts', label: '글' },
  { href: '/resume', label: '이력서' },
];

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky top-0 z-10 border-b border-line bg-bg/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-3xl items-center gap-1 overflow-x-auto whitespace-nowrap px-6 py-3 text-sm">
    <a href="/" class="mr-4 shrink-0 font-semibold text-ink">오영수</a>
    {links.slice(1).map((link) => (
      <a
        href={link.href}
        class:list={[
          'shrink-0 rounded-sm px-3 py-1.5 text-ink-soft hover:text-ink',
          isActive(link.href) && 'text-ink font-semibold border-b-2 border-accent',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
