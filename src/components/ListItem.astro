---
interface Props {
  href: string;
  title: string;
  meta: string;
  summary: string;
  badge?: string;
}
const { href, title, meta, summary, badge } = Astro.props;
---

<a href={href} class="group block border-t border-line py-6 first:border-t-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-bold text-ink group-hover:text-accent">{title}</h3>
    {badge && (
      <span class="font-mono text-[11px] uppercase tracking-wide text-ink-faint">{badge}</span>
    )}
  </div>
  <p class="mt-1 font-mono text-xs text-ink-faint">{meta}</p>
  <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-soft">{summary}</p>
</a>
