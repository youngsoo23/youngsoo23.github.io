---
import BaseLayout from '../layouts/BaseLayout.astro';
import { intro, strengths, approach, skillGroups, education } from '../data/about';
---

<BaseLayout title="소개" description="오영수의 핵심 역량, 업무 방식, 기술 스택 소개">
  <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">About</p>
  <h1 class="mt-2 text-2xl font-bold text-ink">소개</h1>
  <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-ink-soft">{intro.summary}</p>

  <section class="mt-16">
    <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Strengths</p>
    <h2 class="mt-2 text-xl font-bold text-ink">핵심 역량</h2>
    <div class="mt-4">
      {strengths.map((s) => (
        <div class="grid grid-cols-1 gap-1 border-t border-line py-4 first:border-t-0 sm:grid-cols-[200px_1fr] sm:gap-6">
          <h3 class="font-bold text-ink">{s.title}</h3>
          <p class="text-sm leading-relaxed text-ink-soft">{s.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">How I Work</p>
    <h2 class="mt-2 text-xl font-bold text-ink">업무 방식</h2>
    <div class="mt-4">
      {approach.map((a, i) => (
        <div class="grid grid-cols-[28px_1fr] gap-4 border-t border-line py-4 first:border-t-0">
          <span class="font-mono text-xs text-ink-faint">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="font-bold text-ink">{a.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{a.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Skills</p>
    <h2 class="mt-2 text-xl font-bold text-ink">기술 스택</h2>
    <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {skillGroups.map((g) => (
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wide text-ink-faint">{g.label}</p>
          <p class="mt-2 font-mono text-xs text-ink-soft">
            {g.items.map((item, i) => (
              <span>
                {item}
                {i < g.items.length - 1 && <span class="mx-2 text-ink-faint">·</span>}
              </span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-16 border-t border-line pt-6 text-xs text-ink-faint">
    {education.map((e) => (
      <p class="leading-relaxed">
        {e.school} — {e.degree} ({e.period})
      </p>
    ))}
  </section>
</BaseLayout>
