---
import Button from '@/components/common/Button.astro';
import Layout from '@/components/layout/Layout.astro';
import Lede from '@/components/common/Lede.astro';
import PageHero from '@/components/common/PageHero.astro';
import { withBase } from '@/lib/paths';
import { SITE_NAME } from '@/lib/site';
---

<Layout title={`404 — ${SITE_NAME}`} description="페이지를 찾을 수 없습니다." canonicalPath="/404/">
  <main class="content-shell">
    <PageHero title="404" eyebrow="페이지를 찾을 수 없습니다">
      <Lede>주소가 바뀌었거나 삭제된 페이지입니다.</Lede>
      <div class="mt-7 flex flex-wrap gap-4">
        <Button href={withBase('/')}>홈으로</Button>
        <Button href={withBase('/posts/')} variant="secondary">
          글 보기
        </Button>
      </div>
    </PageHero>
  </main>
</Layout>
