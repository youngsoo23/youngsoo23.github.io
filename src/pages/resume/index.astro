---
import { getCollection } from 'astro:content';
import Button from '@/components/common/Button.astro';
import Card from '@/components/common/Card.astro';
import Icon from '@/components/common/Icon.astro';
import Layout from '@/components/layout/Layout.astro';
import { education, intro, skillGroups } from '@/data/about';
import { career, totalExperience } from '@/data/career';
import { formatDuration, formatPeriod, spanMonths } from '@/lib/career';
import { getIcon } from '@/lib/icons';
import { projectName } from '@/lib/content';
import { withBase } from '@/lib/paths';
import {
  AUTHOR_NAME,
  EMAIL,
  GITHUB_URL,
  LINKEDIN_URL,
  RESUME_DESCRIPTION,
  RESUME_PDF_PATH,
  SITE_NAME,
  SITE_URL,
} from '@/lib/site';

const projects = new Map((await getCollection('projects')).map((p) => [p.id, p]));
const contacts = [
  { label: EMAIL, href: `mailto:${EMAIL}` },
  { label: GITHUB_URL.replace('https://', ''), href: GITHUB_URL },
  { label: LINKEDIN_URL.replace('https://', ''), href: LINKEDIN_URL },
  { label: SITE_URL.replace('https://', ''), href: SITE_URL },
].filter((contact) => contact.href);
---

<Layout title={`이력서 — ${SITE_NAME}`} description={RESUME_DESCRIPTION} canonicalPath="/resume/">
  <main class="content-shell">
    <div class="resume section w-full max-w-[860px]!">
      <div class="print-hidden mb-8 flex justify-end">
        <Button href={withBase(RESUME_PDF_PATH)} download>
          <Icon icon={getIcon('download')} />
          PDF 다운로드
        </Button>
      </div>

      <Card as="article" class="resume-sheet sm:p-10">
        <header>
          <h1 class="m-0 text-[2rem] leading-[1.3]">{AUTHOR_NAME}</h1>
          <p class="m-0 font-semibold">
            {intro.role} · 경력 {totalExperience}
          </p>
          <ul class="mt-2 mb-0 flex list-none flex-wrap gap-x-5 p-0 text-[0.9rem] text-ink-soft">
            {contacts.map((contact) => (
              <li>
                <a class="underline underline-offset-4" href={contact.href}>
                  {contact.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-5 mb-0 text-ink-soft">{intro.summary}</p>
        </header>

        <section aria-labelledby="resume-career">
          <h2 id="resume-career">경력</h2>
          {career.map((entry) => (
            <div class="resume-entry">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3>
                  {entry.company}{' '}
                  <span class="resume-role">{[entry.role, entry.note].filter(Boolean).join(' · ')}</span>
                </h3>
                <p class="m-0 font-mono text-[0.8rem] text-muted">
                  {formatPeriod(entry)} ({formatDuration(spanMonths(entry))})
                </p>
              </div>
              <p>{entry.summary}</p>
              {entry.tags.length > 0 && <p class="font-mono text-[0.78rem] text-muted">{entry.tags.join(' · ')}</p>}
              {entry.projectSlugs && (
                <ul>
                  {entry.projectSlugs.map((slug) => {
                    const project = projects.get(slug);
                    if (!project) return null;
                    return (
                      <li>
                        <a
                          class="font-semibold underline underline-offset-4"
                          href={withBase(`/projects/${slug}/`)}
                          set:text={projectName(project)}
                        />
                        {project.data.card && `— ${project.data.card.result}`}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))}
        </section>

        <section aria-labelledby="resume-skills">
          <h2 id="resume-skills">기술 스택</h2>
          <dl class="m-0">
            {skillGroups.map((group) => (
              <div class="grid gap-x-4 sm:grid-cols-[7rem_minmax(0,1fr)]">
                <dt class="font-semibold">{group.label}</dt>
                <dd class="m-0">{group.items.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section aria-labelledby="resume-education">
          <h2 id="resume-education">학력</h2>
          {education.map((item) => (
            <div class="resume-entry">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3>{item.school}</h3>
                <p class="m-0 font-mono text-[0.8rem] text-muted">{item.period}</p>
              </div>
              <p>{item.degree}</p>
            </div>
          ))}
        </section>
      </Card>
    </div>
  </main>
</Layout>

<style>
  .resume {
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .resume h2 {
    margin: 2rem 0 0.8rem;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.25rem;
    font-size: 1.3rem;
  }

  .resume h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .resume-role {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .resume-entry {
    margin-bottom: 1.3rem;
  }

  .resume-entry p,
  .resume-entry ul {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
  }

  .resume-entry ul {
    padding-left: 1.2rem;
    list-style: disc;
  }

  @media print {
    .resume {
      max-width: none !important;
      padding: 0;
    }

    .resume :global(.resume-sheet) {
      border: 0;
      padding: 0;
    }

    .resume h2 {
      margin-top: 1.4rem;
      break-after: avoid;
    }

    .resume-entry {
      break-inside: avoid;
    }
  }
</style>
