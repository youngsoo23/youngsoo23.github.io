---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListItem from '../../components/ListItem.astro';

const all = await getCollection('posts');
const posts = all
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout title="기술 글" description="오영수가 정리한 기술적 판단과 문제 해결 과정">
  <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Posts</p>
  <h1 class="mt-2 text-2xl font-bold text-ink">기술 글</h1>

  {posts.length > 0 ? (
    <div class="mt-8">
      {posts.map((post) => (
        <ListItem
          href={`/posts/${post.id}`}
          title={post.data.title}
          meta={post.data.publishDate.toISOString().slice(0, 10)}
          summary={post.data.summary}
        />
      ))}
    </div>
  ) : (
    <p class="mt-8 text-sm text-ink-faint">곧 첫 글을 공개할 예정입니다.</p>
  )}
</BaseLayout>
