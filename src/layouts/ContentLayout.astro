---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  description: string;
  meta: string;
  tags: string[];
  backHref: string;
  backLabel: string;
}
const { title, description, meta, tags, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <a href={backHref} class="font-mono text-xs text-ink-faint hover:text-accent">{backLabel}</a>

  <article class="mt-6">
    <h1 class="text-2xl font-bold text-ink text-balance">{title}</h1>
    <p class="mt-2 font-mono text-xs text-ink-faint">{meta}</p>

    <div class="prose prose-sm mt-8">
      <slot />
    </div>

    <div class="mt-10 border-t border-line pt-6">
      <Tag tags={tags} />
    </div>
  </article>
</BaseLayout>
